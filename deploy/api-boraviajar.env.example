# Copiar para o servidor como /etc/api-boraviajar.env e ajustar valores.
# Permissões: sudo chmod 600 /etc/api-boraviajar.env

SPRING_PROFILES_ACTIVE=prod

# Porta HTTP desta API (use outra se 8080 estiver ocupada, ex.: 8081)
PORT=8081

# MySQL (mesmo formato que no application.yml)
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/boraviajar_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
DB_USERNAME=
DB_PASSWORD=

# Obrigatório: igual ao JWT_SECRET do backend Node
JWT_SECRET=

# Opcional: push web (VAPID público)
# VAPID_PUBLIC_KEY=
