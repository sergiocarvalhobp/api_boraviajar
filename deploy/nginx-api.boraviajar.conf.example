# Exemplo: /etc/nginx/sites-available/api.boraviajar.net
# A API Java costuma rodar em 127.0.0.1:8081 (ver PORT em /etc/api-boraviajar.env).
#
# IMPORTANTE: em TODOS os proxy_pass, repassar Authorization, X-App-Session e Cookie.
# Se GET /trips/* mostrar myStatus mas POST (avaliar, join, leave) der 401 com
# "Autenticação necessária", o nginx está removendo headers de sessão no POST.
#
#   proxy_set_header Authorization $http_authorization;
#   proxy_set_header X-App-Session $http_x_app_session;
#   proxy_set_header Cookie $http_cookie;
#   proxy_pass_request_headers on;

server {
    listen 443 ssl http2;
    server_name api.boraviajar.net;

    # ssl_certificate ... (certbot)

    # Login mobile — não bloquear POST (alguns templates negam /auth/*)
    location = /api/v1/auth/token {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-App-Session $http_x_app_session;
        proxy_set_header Cookie $http_cookie;
    }

    location = /api/v1/public/session {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-App-Session $http_x_app_session;
        proxy_set_header Cookie $http_cookie;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-App-Session $http_x_app_session;
        proxy_set_header Cookie $http_cookie;
        client_max_body_size 10m;
    }
}
